{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "src/data/projects.ts",
    "src/data/articles.ts",
    "src/data/profile.ts",
    "src/lib/site.ts",
    "src/lib/routes-meta.ts",
    "src/lib/seo.ts",
    "src/data/services.ts",
    "src/lib/static-route-content.ts"
  ]
}
