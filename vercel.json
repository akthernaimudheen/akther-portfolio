{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/iscribe",
      "destination": "/work/clinoria",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/iscribe",
      "destination": "/work/clinoria",
      "permanent": true
    },
    {
      "source": "/projects/clinoria",
      "destination": "/work/clinoria",
      "permanent": true
    },
    {
      "source": "/projects/rshorts",
      "destination": "/work/rshorts",
      "permanent": true
    },
    {
      "source": "/projects/website-projects",
      "destination": "/work/website-projects",
      "permanent": true
    },
    {
      "source": "/projects/technical-lab",
      "destination": "/work/technical-lab",
      "permanent": true
    },
    {
      "source": "/projects/seaking-restaurant",
      "destination": "/work/seaking-restaurant",
      "permanent": true
    },
    {
      "source": "/projects/seaking-suites",
      "destination": "/work/seaking-suites",
      "permanent": true
    },
    {
      "source": "/writing",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
